{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/",
      "has": [{ "type": "header", "key": "Accept", "value": "^text/markdown$" }],
      "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }]
    },
    {
      "source": "/credits",
      "has": [{ "type": "header", "key": "Accept", "value": "^text/markdown$" }],
      "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }]
    },
    {
      "source": "/privacy",
      "has": [{ "type": "header", "key": "Accept", "value": "^text/markdown$" }],
      "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }]
    },
    {
      "source": "/terms",
      "has": [{ "type": "header", "key": "Accept", "value": "^text/markdown$" }],
      "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }]
    },
    {
      "source": "/contact",
      "has": [{ "type": "header", "key": "Accept", "value": "^text/markdown$" }],
      "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }]
    }
  ]
}
